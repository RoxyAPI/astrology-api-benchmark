{
  "format": 1,
  "domain": "western-planets",
  "sources": [
    {
      "name": "NASA JPL Horizons",
      "url": "https://ssd.jpl.nasa.gov/api/horizons.api",
      "command": "python -m benchmark pull western-planets (OBSERVER table, CENTER 500@399, QUANTITIES 31, one minute step)",
      "retrieved": "2026-10-09",
      "licence": "NASA JPL data, public domain US government work; cite Horizons",
      "method": "Apparent geocentric ecliptic longitude of date at the chart instant converted to UT, read from the Observer Ecliptic Longitude column, seven decimal degrees as printed.",
      "notes": "Sun to Mars use their own Horizons centres. Jupiter to Pluto use the Horizons system barycentres 5 to 9: the planetary ephemeris integrates the system barycentres, while the planet centres come from separate satellite solutions that sit off it by thousands of kilometres.",
      "applies_to": [
        "Sun",
        "Moon",
        "Mercury",
        "Venus",
        "Mars",
        "Jupiter",
        "Saturn",
        "Uranus",
        "Neptune",
        "Pluto"
      ]
    },
    {
      "name": "NASA JPL Horizons small-body integration",
      "url": "https://ssd.jpl.nasa.gov/api/horizons.api",
      "command": "python -m benchmark pull western-planets (OBSERVER table, CENTER 500@399, QUANTITIES 31, one minute step)",
      "retrieved": "2026-10-09",
      "licence": "NASA JPL data, public domain US government work; cite Horizons",
      "method": "Apparent geocentric ecliptic longitude of the small body 2060 Chiron at the chart instant converted to UT, which Horizons integrates on demand from the initial conditions of its orbit solution, read from the same column as the planets.",
      "applies_to": [
        "Chiron"
      ]
    }
  ],
  "families": [
    {
      "label": "Sun, Moon, planets and Chiron",
      "quantities": [
        "Sun",
