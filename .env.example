# Copy to .env.local (gitignored) and fill in the key. The runner reads the environment first, then this file.

# Key for the API under test. Required.
BENCHMARK_API_KEY=

# Header the key is sent in. X-API-Key is the default; change it only for an API that expects another header.
BENCHMARK_API_KEY_HEADER=X-API-Key

# Console colour: forced on with FORCE_COLOR=1, off with NO_COLOR=1; detected from the terminal when both are unset.
# FORCE_COLOR=1
# NO_COLOR=1
