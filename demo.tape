# Records assets/run.gif: the real command, run live. Regenerated by the benchmark workflow.
# The API key comes from the environment (the workflow secret) or .env.local, and is never typed.
Output assets/run.gif

Require uv

Set Shell bash
Set Theme "Catppuccin Mocha"
Set FontFamily "JetBrains Mono"
Set FontSize 19
Set Width 1200
Set Height 1180
Set Padding 20
Set Framerate 10
Set PlaybackSpeed 6
Set TypingSpeed 60ms

Hide
Env FORCE_COLOR "1"
Env PS1 "$ "
Type "clear" Enter
Show

Sleep 1s
Type "uv run python -m benchmark run"
Sleep 500ms
Enter

Wait+Screen@600s /Scorecard/
Sleep 8s
